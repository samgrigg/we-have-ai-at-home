# Copy to .env; do not commit the resulting file.
DATABASE_URL=postgresql://household:household-local-only@localhost:5433/household
HOUSEHOLD_PASSWORD=replace-with-a-long-random-password
OPENAI_API_KEY=
MODEL_NAME=gpt-4.1-mini
# Override if port 8000 is already used on your machine.
API_PORT=8000
PROGRESS_LOG_SECONDS=5
SLOW_STAGE_SECONDS=10
# Optional: fill in current provider rates to record estimated USD per request.
# INPUT_USD_PER_MILLION=
# OUTPUT_USD_PER_MILLION=
